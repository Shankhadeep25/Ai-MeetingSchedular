# ============================================================
# AI Meeting Scheduler — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# Groq API (FREE at console.groq.com)
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Calendar OAuth2
# Local development: Place your downloaded credentials.json in the project root
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
# Cloud deployment (Render / Railway / Streamlit Cloud):
# Paste the 1-line content of your local token.json directly:
# GOOGLE_TOKEN_JSON={"token": "...", "refresh_token": "...", ...}

# Timezone (IANA format)
DEFAULT_TIMEZONE=Asia/Kolkata

# Cloud Databases (Leave blank to default to local SQLite & ChromaDB)
# Neon.tech or Supabase Cloud PostgreSQL:
DATABASE_URL=postgresql://user:password@ep-something.neon.tech/neondb?sslmode=require
# Pinecone Cloud Vector DB (Free at https://www.pinecone.io):
PINECONE_API_KEY=pcsk_your_key_here
PINECONE_INDEX_NAME=ai-meetings

# Local Fallback Paths
SQLITE_DB_PATH=./data/meetings.db
CHROMA_PERSIST_DIR=./data/chroma

# Defaults
DEFAULT_MEETING_DURATION=30
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Stretch: ntfy.sh topic (pick any unique string)
NTFY_TOPIC=ai-meeting-scheduler-yourname
